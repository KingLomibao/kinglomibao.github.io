DATABASE_URL=postgresql+psycopg2://kinvera:kinvera@localhost:5432/kinvera
DEFAULT_RELIEF_WINDOW_DAYS=30
MINIMUM_REST_DAYS=2
API_CORS_ORIGINS=["http://localhost:3000"]

# AI Operations Assistant (Phase 2) - optional. Every other Kinvera
# feature works with these unset; the assistant endpoint reports
# itself as "not configured" instead of failing to start. Never commit
# a real key - get one from https://console.anthropic.com/ and put it
# in your own untracked .env only.
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=claude-sonnet-4-5
